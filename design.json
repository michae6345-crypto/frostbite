    "host_to_device": {
      "0x01 SET_SLOT": "[0x01, slot 0-5, status]",
      "0x02 SET_ALL": "[0x02, s0, s1, s2, s3, s4, s5]",
      "0x03 OLED_LINE": "[0x03, line 0-1, len, up to 21 ASCII bytes]",
      "0x04 SET_GLOW": "[0x04, r, g, b, brightness 0-255]",
      "0x05 PING": "[0x05] -> device answers [0x05, protocol_version=1, selected_slot]",
      "0x06 SET_SELECTED": "[0x06, slot 0-5]"
    },
    "device_to_host": {
      "0x81 KEY": "[0x81, key index 0-8 (keys[] order), action 1=tap 2=hold]",
      "0x82 ENCODER": "[0x82, 1=clockwise 0xFF=counter-clockwise, selected_slot after the move]"
    },
    "fallback_without_host": "If no PING for 5 s, keys send keycodes instead: agent1-6 = F13-F18, approve = F19, talk = F20 (held while held), stop = Escape; encoder = volume. Status LEDs fade to idle."
